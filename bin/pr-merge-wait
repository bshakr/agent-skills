#!/usr/bin/env bash
# pr-merge-wait — watch open pull requests until one merges, closes or starts
# conflicting, then report once and exit.
#
#   pr-merge-wait <pr-number|pr-url> [<pr> ...] [--repo owner/name]
#                 [--interval SECONDS] [--timeout DURATION]
#
# Exit codes: 0 a PR merged, 3 a PR was closed unmerged, 4 a PR went
# conflicting/behind, 5 timeout (all still open and clean), 2 usage or gh error.
#
# Why this exists (measured 2026-09-20): the merge watch was ScheduleWakeup, and
# every wake was a full coordinator turn at 300-400k context whose whole content
# was "still open, still clean" — 51 of them across 16 sessions, 44 of those
# waiting on a human merge call. Started with run_in_background: true this costs
# no tokens while it waits and wakes the model exactly once, with something to do.
# Sibling of pr-ci-wait: same arg style, same repo detection, same exit-code
# discipline. Stays silent between polls because its output is read by a model.

set -euo pipefail

PROG=${0##*/}

usage() {
	cat >&2 <<'USAGE'
usage: pr-merge-wait <pr-number|pr-url> [<pr> ...] [--repo owner/name]
                     [--interval SECONDS (default 120)]
                     [--timeout DURATION (default 12h; 90, 45s, 30m, 12h)]

Silent while every watched PR stays open and clean; prints a handful of lines and
exits the moment one of them needs a coordinator action.

exit 0 merged | 3 closed unmerged | 4 conflicting/behind | 5 timeout | 2 usage or gh error
USAGE
}

die() {
	printf '%s: %s\n' "$PROG" "$1" >&2
	exit "${2:-2}"
}

progress() { printf '[%s] %s\n' "$PROG" "$1" >&2; }

REPO=""
TIMEOUT=43200
INTERVAL=120
MAX_FAILS=10
TARGETS=()

parse_duration() {
	local raw=$1 num unit
	case "$raw" in
	*[0-9]) num=$raw unit=s ;;
	*[sS]) num=${raw%?} unit=s ;;
	*[mM]) num=${raw%?} unit=m ;;
	*[hH]) num=${raw%?} unit=h ;;
	*) die "--timeout must be seconds or a duration like 45s, 30m, 12h: $raw" ;;
	esac
	case "$num" in '' | *[!0-9]*) die "--timeout must be seconds or a duration like 45s, 30m, 12h: $raw" ;; esac
	case "$unit" in
	s) printf '%s' "$num" ;;
	m) printf '%s' "$((num * 60))" ;;
	h) printf '%s' "$((num * 3600))" ;;
	esac
}

while [ $# -gt 0 ]; do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	--repo)
		[ $# -ge 2 ] || die "--repo needs a value"
		REPO=$2
		shift 2
		;;
	--repo=*)
		REPO=${1#--repo=}
		shift
		;;
	--timeout)
		[ $# -ge 2 ] || die "--timeout needs a value"
		TIMEOUT=$(parse_duration "$2")
		shift 2
		;;
	--timeout=*)
		TIMEOUT=$(parse_duration "${1#--timeout=}")
		shift
		;;
	--interval)
		[ $# -ge 2 ] || die "--interval needs a value"
		INTERVAL=$2
		shift 2
		;;
	--interval=*)
		INTERVAL=${1#--interval=}
		shift
		;;
	-*) die "unknown flag: $1" ;;
	*)
		TARGETS+=("$1")
		shift
		;;
	esac
done

[ ${#TARGETS[@]} -gt 0 ] || {
	usage
	exit 2
}
case "$INTERVAL" in '' | *[!0-9]* | 0) die "--interval must be a positive whole number of seconds" ;; esac
[ "$TIMEOUT" -gt 0 ] || die "--timeout must be greater than zero"

command -v gh >/dev/null 2>&1 || die "gh is not on PATH"

# --- resolve PR numbers and repos ------------------------------------------
PRS=()
PR_REPOS=()
URLS=()

for target in "${TARGETS[@]}"; do
	pr=""
	repo=$REPO
	case "$target" in
	http://* | https://*)
		pr=$(printf '%s\n' "$target" | sed -n 's#.*/pull/\([0-9][0-9]*\).*#\1#p')
		[ -n "$pr" ] || die "could not read a PR number out of URL: $target"
		repo=$(printf '%s\n' "$target" | sed -n 's#^https\{0,1\}://[^/]*/\([^/]*\)/\([^/]*\)/pull/.*#\1/\2#p')
		;;
	*[!0-9]*) die "arguments must be PR numbers or PR URLs: $target" ;;
	*) pr=$target ;;
	esac
	if [ -z "$repo" ]; then
		repo=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null) ||
			die "no --repo given and the current directory has no GitHub remote"
		REPO=$repo
	fi
	PRS+=("$pr")
	PR_REPOS+=("$repo")
	URLS+=("https://github.com/$repo/pull/$pr")
done

N=${#PRS[@]}

# --- per-PR state ----------------------------------------------------------
STATE=()
MERGEABLE=()
MSS=()
SHA=()
REF=()
FAILS=()
i=0
while [ "$i" -lt "$N" ]; do
	STATE+=("OPEN")
	MERGEABLE+=("UNKNOWN")
	MSS+=("UNKNOWN")
	SHA+=("")
	REF+=("")
	FAILS+=("0")
	i=$((i + 1))
done

FIELDS='state,mergeable,mergeStateStatus,mergeCommit,headRefName'
# Joined on "|", not a tab: tab is an IFS whitespace character, so `read` would
# collapse the empty mergeCommit of an unmerged PR and shift every later field.
QUERY='[.state, .mergeable, .mergeStateStatus, (.mergeCommit.oid // ""), .headRefName] | join("|")'

# CONFLICTING, DIRTY and BEHIND all mean "rebase before this can land".
# mergeable UNKNOWN is no information at all — GitHub reports it while it
# recomputes the merge — and is never read as a change.
is_bad() {
	local mergeable=$1 mss=$2
	case "$mergeable" in
	CONFLICTING) return 0 ;;
	UNKNOWN) return 1 ;;
	esac
	case "$mss" in
	DIRTY | BEHIND) return 0 ;;
	esac
	return 1
}

pr_line() {
	local i=$1 line
	line=$(printf '%s  state=%s  mergeStateStatus=%s  branch=%s' \
		"${URLS[$i]}" "${STATE[$i]}" "${MSS[$i]}" "${REF[$i]}")
	[ -n "${SHA[$i]}" ] && line="$line  merge_commit=${SHA[$i]}"
	printf '%s\n' "$line"
}

open_others() {
	# branches of the still-open watched PRs, for the "rebase the rest" line
	local i=0 out=""
	while [ "$i" -lt "$N" ]; do
		if [ "${STATE[$i]}" = "OPEN" ] && [ -n "${REF[$i]}" ]; then
			out="$out ${REF[$i]}"
		fi
		i=$((i + 1))
	done
	printf '%s' "${out# }"
}

report() {
	local verdict=$1 hit=$2 elapsed=$3 i=0 rest
	while [ "$i" -lt "$N" ]; do
		pr_line "$i"
		i=$((i + 1))
	done
	case "$verdict" in
	merged)
		rest=$(open_others)
		printf 'next: git fetch origin main, rebase %s and re-verify CI, then continue the wave (wave §3)\n' \
			"${rest:-every remaining open wave branch}"
		exit 0
		;;
	closed)
		printf 'next: closed unmerged — stop work on %s and ask Bass before reopening or re-pushing (wave §3)\n' \
			"${REF[$hit]:-that branch}"
		exit 3
		;;
	bad)
		printf 'next: rebase %s on origin/main, push --force-with-lease, re-verify CI (wave §2)\n' \
			"${REF[$hit]:-that branch}"
		exit 4
		;;
	timeout)
		printf 'next: nothing — watched %ss, every PR above still open and clean; re-arm pr-merge-wait in the background if the wait should continue\n' \
			"$elapsed"
		exit 5
		;;
	esac
}

progress "watching $N PR(s) — interval=${INTERVAL}s timeout=${TIMEOUT}s; silent until something changes"

start=$(date +%s)
deadline=$((start + TIMEOUT))
first_pass=1

while :; do
	i=0
	verdict=""
	hit=0
	while [ "$i" -lt "$N" ]; do
		if raw=$(gh pr view "${PRS[$i]}" --repo "${PR_REPOS[$i]}" --json "$FIELDS" -q "$QUERY" 2>&1); then
			FAILS[i]=0
			IFS='|' read -r st mrg mss sha ref <<<"$raw"
			STATE[i]=${st:-UNKNOWN}
			MERGEABLE[i]=${mrg:-UNKNOWN}
			MSS[i]=${mss:-UNKNOWN}
			SHA[i]=$sha
			REF[i]=$ref
			# Precedence when several PRs move in the same poll: a merge subsumes
			# the others, since its next action rebases every remaining branch.
			case "${STATE[$i]}" in
			MERGED)
				if [ "$verdict" != merged ]; then
					verdict=merged
					hit=$i
				fi
				;;
			CLOSED)
				if [ -z "$verdict" ] || [ "$verdict" = bad ]; then
					verdict=closed
					hit=$i
				fi
				;;
			*)
				if is_bad "${MERGEABLE[$i]}" "${MSS[$i]}" && [ -z "$verdict" ]; then
					verdict=bad
					hit=$i
				fi
				;;
			esac
		else
			# A permanent problem (wrong number, no access) shows up on the very
			# first look; after that, network and API blips are retried quietly.
			if [ "$first_pass" -eq 1 ]; then
				printf '%s: cannot read PR %s in %s\n%s\n' \
					"$PROG" "${PRS[$i]}" "${PR_REPOS[$i]}" "$raw" >&2
				exit 2
			fi
			FAILS[i]=$((FAILS[i] + 1))
			if [ "${FAILS[$i]}" -ge "$MAX_FAILS" ]; then
				printf '%s: gh failed %s times in a row on %s\n%s\n' \
					"$PROG" "${FAILS[$i]}" "${URLS[$i]}" "$raw" >&2
				exit 2
			fi
		fi
		i=$((i + 1))
	done
	first_pass=0

	[ -n "$verdict" ] && report "$verdict" "$hit" 0

	now=$(date +%s)
	elapsed=$((now - start))
	remaining=$((deadline - now))
	[ "$remaining" -le 0 ] && report timeout 0 "$elapsed"
	if [ "$remaining" -lt "$INTERVAL" ]; then
		sleep "$remaining"
	else
		sleep "$INTERVAL"
	fi
done
